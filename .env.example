# Variables optionnelles (local : copie en .env.local). Sur GitHub Pages, elles sont définies
# dans .github/workflows/pages.yml et dans Settings → Secrets and variables → Actions → Variables.

# Lien Stripe Payment Link. Vide = les boutons ouvrent un email de commande pré-rempli.
NEXT_PUBLIC_STRIPE_LINK=

# URL publique du site (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://vavacry.github.io/12testeurs

# Sous-dossier du site : /12testeurs sur GitHub Pages, vide avec un domaine à soi ou en local.
NEXT_PUBLIC_BASE_PATH=

# Email de contact.
NEXT_PUBLIC_CONTACT_EMAIL=vacryoff@gmail.com

# Optionnel : copie des commandes vers un webhook (Make, Zapier, n8n…). Visible côté navigateur.
NEXT_PUBLIC_ORDER_WEBHOOK_URL=
