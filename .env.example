# Copie ce fichier en .env.local (local) ou renseigne ces variables dans Vercel.
# Les variables NEXT_PUBLIC_* sont intégrées au build : après modification, redéploie.

# Lien Stripe Payment Link (ex. https://buy.stripe.com/xxxx). Vide = les boutons pointent vers #tarif.
NEXT_PUBLIC_STRIPE_LINK=

# URL publique du site : canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=https://12testeurs.fr

# Email de contact affiché après la commande et en cas d'erreur d'envoi.
NEXT_PUBLIC_CONTACT_EMAIL=

# Webhook qui reçoit les commandes du formulaire /commande (Make, Zapier, n8n, Discord, Slack…).
# Côté serveur uniquement, jamais exposé au navigateur. Obligatoire en production.
ORDER_WEBHOOK_URL=
